<?xml version="1.0" encoding="UTF-8"?>

<!--
  "Compensation" tab: where the spillover matrix comes from, and the matrix itself, editable cell
  by cell. Texts are message keys (see main-view.fxml); the matrix is built by the controller.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="10" styleClass="tab-content"
      fx:controller="com.bioinfo.cytoscope.desktop.controller.CompensationTabController">

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="compensation.source"/>
        <ComboBox fx:id="sourceBox"/>
        <Button fx:id="computeButton" text="compensation.fromControls" onAction="#onCompute"/>
        <Label fx:id="controlsLabel" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="?" styleClass="help-button" onAction="#onHelp">
            <tooltip><Tooltip text="tip.tabHelp"/></tooltip>
        </Button>
    </HBox>

    <Label fx:id="placeholderLabel" styleClass="muted" wrapText="true"/>
    <Label fx:id="captionLabel" text="compensation.caption" styleClass="muted" wrapText="true"/>
    <ScrollPane fx:id="matrixScroll" VBox.vgrow="ALWAYS" styleClass="plain-scroll">
        <GridPane fx:id="matrixGrid" hgap="4" vgap="4" styleClass="matrix"/>
    </ScrollPane>
</VBox>
